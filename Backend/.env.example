# Copy this file to ".env" and fill in the values. Never commit .env to GitHub.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (free M0 cluster is fine)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/rge?retryWrites=true&w=majority

# A long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# The website's address (no trailing slash). Several can be comma-separated.
FRONTEND_URL=http://localhost:5173

# This API's public address once deployed, e.g. https://rge-api.onrender.com
PUBLIC_API_URL=http://localhost:5000

# Cloudinary (cloudinary.com → Dashboard → API keys). Leave empty to store files on disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rge

# Upload limits and how long a download link works.
# Audio is automatically compressed to a mono MP3 at AUDIO_BITRATE before it is stored
# (64k ≈ 29 MB per hour of preaching), so originals up to MAX_AUDIO_MB can be uploaded.
MAX_AUDIO_MB=300
AUDIO_BITRATE=64k
MAX_IMAGE_MB=5
DOWNLOAD_LINK_MINUTES=10

# Email for password resets (e.g. Gmail with an App Password, Brevo, Mailgun).
# Leave empty during development: reset links are printed in the terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Revive Gospel Embassy <no-reply@example.com>
